% ============================================================================
%  linuxnotes.sty  --  Accessible baseline for Linux class documents
%  Same look and WCAG 2.1 AA choices as classnotes.sty, plus helpers for
%  documenting terminal work: command, output, and script listings, and
%  inline macros for commands, file paths, and keys.
%
%  Part of Work-Dev. Copyright (c) 2026 Jason Powell. MIT License.
%
%  Usage:
%     \usepackage[pagenumbers]{linuxnotes}   % footer "Page X of Y"
%     \usepackage{linuxnotes}                % no page numbers (one-pagers)
%  Then near the top of the document:
%     \linuxnotesmeta{The PDF Title}         % sets PDF title + language
%     \linuxnotestitle{EYEBROW}{Title}{Subtitle}
%
%  Keep this file in the same folder as your .tex, or install it in your
%  local texmf tree so \usepackage{linuxnotes} works from anywhere.
% ============================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{linuxnotes}[2026/11/08 v1.0 Accessible Linux class-notes baseline]

\newif\ifln@pagenumbers
\DeclareOption{pagenumbers}{\ln@pagenumberstrue}
\ProcessOptions\relax

% ---------- required packages ----------
% T1 keeps a literal > or < in body text from rendering as an upside-down
% question or exclamation mark. Load it before anything else touches fonts.
\RequirePackage[T1]{fontenc}
% Latin Modern supplies scalable T1 fonts. Without it, systems that lack the
% cm-super fonts fall back to bitmaps, which blur when zoomed and make the
% PDF text harder for Acrobat and screen readers to read.
\RequirePackage{lmodern}
% Latin Modern's typewriter font joins "--" into a dash, which corrupts
% options such as --oneline in \cmd and table text. Turn off ligatures in
% monospace text only; all other typesetting is left unchanged.
\RequirePackage[protrusion=false,expansion=false]{microtype}
\DisableLigatures{encoding = *, family = tt*}
\RequirePackage[margin=1in]{geometry}
\RequirePackage[table]{xcolor}
\RequirePackage{listings}
\RequirePackage{enumitem}
\RequirePackage{parskip}
\RequirePackage{titlesec}
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{caption}
\ifln@pagenumbers
  \RequirePackage{lastpage}
  \RequirePackage{fancyhdr}
\fi
\RequirePackage{hyperref} % loaded late on purpose

% ---------- accessible colors ----------
% Text shades below meet WCAG 2.1 AA on their intended backgrounds
% (>= 4.5:1 for body text, >= 3:1 for large or bold text), including on the
% light code background. Do not lighten teal, amber, or the comment gray
% without re-checking contrast.
\definecolor{navy}{HTML}{0E1B33}
\definecolor{navysoft}{HTML}{24365F}
\definecolor{teal}{HTML}{0B7A6F}
\definecolor{amber}{HTML}{8A5F00}
\definecolor{coral}{HTML}{C6564A}
\definecolor{codebg}{HTML}{F2F5FA}
\definecolor{outbg}{HTML}{FFFFFF}
\definecolor{codecmt}{HTML}{596683}
\definecolor{rulecol}{HTML}{3E5488}
\definecolor{notebg}{HTML}{FBF3E2}
\definecolor{keybg}{HTML}{EEF1F6}

% ---------- headings (real \section structure aids PDF tagging) ----------
\titleformat{\section}{\Large\bfseries\color{navy}}{\thesection.}{0.6em}{}
\titleformat{\subsection}{\large\bfseries\color{teal}}{}{0em}{}
\titlespacing*{\section}{0pt}{1.4em}{0.5em}

% ---------- captions (give every table a programmatic label) ----------
\captionsetup{font=small, labelfont={bf,color=navy}, textfont={color=navy}, skip=4pt}

% ---------- inline macros ----------
% \cmd{ls -l | grep foo}   a command typed at the shell
% \file{/etc/fstab}        a file or directory path (teal monospace)
% \key{Ctrl+C}             a key or key combination (boxed)
% \var{FILENAME}           a placeholder the reader replaces (italic)
\newcommand{\cmd}[1]{\texttt{\detokenize{#1}}}
\newcommand{\file}[1]{\textcolor{teal}{\texttt{\detokenize{#1}}}}
\newcommand{\key}[1]{%
  \fcolorbox{rulecol}{keybg}{\rule[-0.2em]{0pt}{0.9em}\footnotesize\texttt{\detokenize{#1}}}%
}
\newcommand{\var}[1]{\textit{\texttt{#1}}}

% ---------- highlighted note boxes ----------
% \notebox{Label.}{Text}   general aside (amber label)
% \warnbox{Label.}{Text}   caution, such as a destructive command. The bold
%                          label carries the meaning, so color is not the
%                          only signal.
\newcommand{\notebox}[2]{%
  \par\vspace{4pt}%
  \noindent\colorbox{notebg}{%
    \parbox{\dimexpr\linewidth-2\fboxsep}{%
      \small\textbf{\color{amber}#1}\quad #2%
    }%
  }\par\vspace{6pt}%
}
\newcommand{\warnbox}[2]{%
  \par\vspace{4pt}%
  \noindent\fcolorbox{coral}{white}{%
    \parbox{\dimexpr\linewidth-2\fboxsep-2\fboxrule}{%
      \small\textbf{\color{navy}#1}\quad #2%
    }%
  }\par\vspace{6pt}%
}

% ---------- listing styles ----------
% sh      commands you type (shaded, # comments in gray). Default style.
% output  what the terminal prints back (white, left rule only, no comment
%         coloring, so a root prompt "#" or a "#" in output stays plain).
% script  a saved Bash script (shaded, line numbers, keywords in bold).
\lstdefinestyle{sh}{
  backgroundcolor=\color{codebg},
  basicstyle=\ttfamily\small,
  breaklines=true,
  keepspaces=true,
  showstringspaces=false,
  columns=fullflexible,
  frame=single,
  rulecolor=\color{rulecol},
  framesep=6pt,
  xleftmargin=6pt,
  xrightmargin=6pt,
  aboveskip=8pt,
  belowskip=8pt,
  morecomment=[l][\color{codecmt}\itshape]{\#}
}
\lstdefinestyle{output}{
  backgroundcolor=\color{outbg},
  basicstyle=\ttfamily\small\color{navysoft},
  breaklines=true,
  keepspaces=true,
  showstringspaces=false,
  columns=fullflexible,
  frame=leftline,
  framerule=2pt,
  rulecolor=\color{rulecol},
  framesep=8pt,
  xleftmargin=10pt,
  xrightmargin=6pt,
  aboveskip=4pt,
  belowskip=8pt
}
\lstdefinestyle{script}{
  style=sh,
  language=bash,
  keywordstyle=\bfseries\color{navy},
  stringstyle=\color{amber},
  commentstyle=\color{codecmt}\itshape,
  numbers=left,
  numberstyle=\scriptsize\color{codecmt},
  numbersep=10pt,
  xleftmargin=20pt
}
\lstset{style=sh}

% ---------- page numbers (optional) ----------
\ifln@pagenumbers
  \pagestyle{fancy}
  \fancyhf{}
  \renewcommand{\headrulewidth}{0pt}
  \renewcommand{\footrulewidth}{0pt}
  \cfoot{\small\color{navysoft}Page \thepage\ of \pageref{LastPage}}
\else
  \pagestyle{empty}
\fi

% ---------- accessibility metadata ----------
% \linuxnotesmeta{PDF title}. Sets the document title and language, which
% assistive technology and Acrobat both rely on. Language defaults to en-US.
\newcommand{\linuxnotesmeta}[1]{%
  \hypersetup{hidelinks, pdftitle={#1}, pdflang={en-US},
    pdfdisplaydoctitle=true, bookmarksnumbered=true}%
}

% ---------- title block ----------
% \linuxnotestitle{EYEBROW}{Title}{Subtitle}
\newcommand{\linuxnotestitle}[3]{%
  \begin{center}
    {\color{teal}\small\bfseries #1}\\[6pt]
    {\color{navy}\Huge\bfseries #2}\\[8pt]
    {\color{navysoft}\large #3}
  \end{center}
  \vspace{0.4em}%
  \noindent\textcolor{rulecol}{\rule{\linewidth}{1.2pt}}%
  \vspace{0.6em}%
}

\endinput
